{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sydon.ai/schemas/upstream_evidence_contract.json",
  "title": "UpstreamManagersEvidenceContract",
  "description": "Cross-pod evidence contract specifying the structured operational records consumed from Receiving, Prep, Pack, and Returns Managers.",
  "type": "object",
  "definitions": {
    "ReceivingRecord": {
      "type": "object",
      "description": "Evidence generated by 01 Receiving Manager at warehouse intake dock.",
      "required": ["record_id", "unit_id", "org_id", "po_number", "sku", "qty_received", "carton_damage", "unit_damage", "captured_at"],
      "properties": {
        "record_id": { "type": "string", "example": "RCV-0014" },
        "unit_id": { "type": "string", "example": "UNIT-0014" },
        "org_id": { "type": "string", "example": "org_demo_alpha" },
        "po_number": { "type": "string", "example": "PO-7003" },
        "po_line": { "type": ["integer", "null"] },
        "supplier": { "type": "string", "example": "Supplier Coastal (DUMMY)" },
        "sku": { "type": "string", "example": "SKU-LAMP-LED" },
        "asin": { "type": ["string", "null"], "example": "B0DUMMY357" },
        "product_title": { "type": "string" },
        "spec_colour": { "type": ["string", "null"] },
        "spec_variant": { "type": ["string", "null"] },
        "spec_components": { "type": ["string", "null"] },
        "cartons_ordered": { "type": "integer" },
        "cartons_received": { "type": "integer" },
        "units_per_carton_ordered": { "type": "integer" },
        "units_per_carton_counted": { "type": "integer" },
        "qty_ordered": { "type": "integer" },
        "qty_received": { "type": "integer", "description": "Actual units physically received into dock." },
        "identity_match": { "type": "string", "enum": ["yes", "no", "uncertain"] },
        "carton_damage": { "type": "string", "enum": ["none", "crushing", "tears", "wet", "open", "uncertain"] },
        "unit_damage": { "type": "string", "enum": ["none", "crushing", "scratch", "water", "broken", "uncertain"] },
        "quality_flags": { "type": ["string", "null"], "description": "Flags such as obvious_defect, wrong_colour, missing_components." },
        "photo_refs": { "type": "string", "description": "Semicolon-delimited image references (pallet, carton, unit)." },
        "operator_id": { "type": "string", "example": "op_amira" },
        "captured_at": { "type": "string", "format": "date-time" }
      }
    },
    "PrepRecord": {
      "type": "object",
      "description": "Evidence generated by 02 Prep Manager documenting unit-level compliance prior to FBA shipment dispatch.",
      "required": ["record_id", "unit_id", "org_id", "fba_shipment_id", "sku", "fnsku", "fnsku_label_placement", "original_barcode_covered", "captured_at"],
      "properties": {
        "record_id": { "type": "string", "example": "PRP-0014" },
        "unit_id": { "type": "string", "example": "UNIT-0014" },
        "org_id": { "type": "string", "example": "org_demo_alpha" },
        "work_order_id": { "type": "string", "example": "WO-3002" },
        "fba_shipment_id": { "type": "string", "example": "FBA-DUMMY-101" },
        "sku": { "type": "string", "example": "SKU-LAMP-LED" },
        "asin": { "type": ["string", "null"], "example": "B0DUMMY357" },
        "fnsku": { "type": "string", "example": "X00DUMMY014" },
        "prep_price_usd": { "type": "number", "example": 0.55 },
        "wo_polybag": { "type": "boolean", "description": "Work order required polybag." },
        "wo_suffocation_warning": { "type": "boolean", "description": "Work order required suffocation warning." },
        "wo_expiry_date": { "type": "boolean", "description": "Work order required expiration date labeling." },
        "wo_handling_marks": { "type": ["string", "null"], "description": "e.g. fragile;this_way_up." },
        "polybag_present_sealed": { "type": "string", "enum": ["yes", "no", "not_required", "not_sealed", "uncertain"] },
        "suffocation_warning": { "type": "string", "enum": ["legible", "missing", "not_required", "illegible", "uncertain"] },
        "fnsku_label_placement": { "type": "string", "enum": ["flat", "on_curve", "on_seam", "missing", "uncertain"] },
        "original_barcode_covered": { "type": "string", "enum": ["yes", "no", "not_required", "partially_covered", "uncertain"] },
        "expiry_date": { "type": "string", "enum": ["legible", "missing", "not_required", "illegible", "uncertain"] },
        "handling_marks": { "type": "string", "enum": ["all_present", "some_missing", "none_present", "not_required", "uncertain"] },
        "photo_refs": { "type": "string", "description": "Semicolon-delimited image references (front, back, label)." },
        "operator_id": { "type": "string", "example": "op_chen" },
        "captured_at": { "type": "string", "format": "date-time" }
      }
    },
    "PackRecord": {
      "type": "object",
      "description": "Evidence generated by 03 Pack Manager for merchant-fulfilled or 3PL shipments.",
      "required": ["record_id", "unit_id", "org_id", "order_id", "channel", "order_lines", "observed_in_box", "operator_verdict", "captured_at"],
      "properties": {
        "record_id": { "type": "string", "example": "PCK-0006" },
        "unit_id": { "type": "string", "example": "UNIT-0006" },
        "org_id": { "type": "string", "example": "org_demo_bravo" },
        "order_id": { "type": "string", "example": "ORD-DUMMY-50006" },
        "channel": { "type": "string", "enum": ["amazon_mfn", "shopify", "walmart", "other"] },
        "order_lines": { "type": "string", "description": "Ordered SKU and qty e.g. SKU-CABLE-USBC:1" },
        "observed_in_box": { "type": "string", "description": "Items physically verified inside carton before taping." },
        "operator_verdict": { "type": "string", "enum": ["seal", "stop_and_fix", "uncertain"] },
        "photo_refs": { "type": "string", "description": "Photo of open box before tape." },
        "operator_id": { "type": "string", "example": "op_ben" },
        "captured_at": { "type": "string", "format": "date-time" }
      }
    },
    "ReturnsRecord": {
      "type": "object",
      "description": "Evidence generated by 04 Returns Manager during return intake and disposition grading.",
      "required": ["record_id", "unit_id", "org_id", "order_id", "ordered_sku", "identity_match", "observed_state", "operator_disposition", "captured_at"],
      "properties": {
        "record_id": { "type": "string", "example": "RTN-0014" },
        "unit_id": { "type": "string", "example": "UNIT-0014" },
        "org_id": { "type": "string", "example": "org_demo_alpha" },
        "order_id": { "type": "string", "example": "ORD-DUMMY-50014" },
        "ordered_sku": { "type": "string", "example": "SKU-LAMP-LED" },
        "ordered_asin": { "type": ["string", "null"], "example": "B0DUMMY357" },
        "identity_match": { "type": "string", "enum": ["yes", "no", "uncertain"] },
        "parts_list": { "type": ["string", "null"] },
        "parts_missing": { "type": ["string", "null"] },
        "observed_state": { "type": "string", "enum": ["factory_sealed", "opened_unused", "signs_of_use", "damaged", "destroyed", "uncertain"] },
        "amazon_condition": { "type": ["string", "null"], "description": "Channel's alleged condition category." },
        "operator_disposition": { "type": "string", "enum": ["restock", "refurbish", "liquidate", "dispose", "uncertain"] },
        "photo_refs": { "type": "string", "description": "Condition photos of returned unit." },
        "operator_id": { "type": "string", "example": "op_eli" },
        "captured_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
